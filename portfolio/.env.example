# Variables del portafolio (hgsportafolio.site). En producción van en Netlify:
# sitio portafolio-hgs → Project configuration → Environment variables. Nunca subas un .env con valores reales.
#
# Los correos del formulario de contacto ya no salen de aquí: el formulario envía a admin.hgsportafolio.site/api/contact
# y sus variables (RESEND_API_KEY, CONTACT_TO, CONTACT_FROM) van en el sitio admin-hgs. Ver admin/.env.example.

# Analítica sin cookies de Umami Cloud (cloud.umami.is → Add website → Website ID). Vacío = desactivada.
VITE_UMAMI_WEBSITE_ID=

# Ya fijado en netlify.toml; solo para builds fuera de Netlify.
# VITE_SITE_URL=https://hgsportafolio.site
